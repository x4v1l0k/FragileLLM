# --- Transport ---
# http_json | http_openai | websocket | websocket_binary | sse | tcp | all
FRAGILELLM_TRANSPORT=all

FRAGILELLM_HOST=0.0.0.0
FRAGILELLM_HTTP_PORT=8601
FRAGILELLM_TCP_PORT=8602

# --- Global LLM switch (only this selects the backend) ---
# ollama | deepseek | openai | azure | openrouter | groq | mistral | together | vllm | lmstudio
FRAGILELLM_LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
# OLLAMA_API_KEY=

# --- DeepSeek ---
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=

# --- OpenAI ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Azure OpenAI ---
# AZURE_OPENAI_ENDPOINT=https://YOUR.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-5
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_REASONING_EFFORT=minimal
# AZURE_OPENAI_USE_DEPLOYMENTS=0

# --- OpenRouter ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/auto
# OPENROUTER_API_KEY=

# --- Groq ---
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=

# --- Mistral ---
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_API_KEY=

# --- Together ---
# TOGETHER_BASE_URL=https://api.together.xyz/v1
# TOGETHER_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct-Turbo
# TOGETHER_API_KEY=

# --- vLLM ---
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=default
# VLLM_API_KEY=

# --- LM Studio ---
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=local-model
# LMSTUDIO_API_KEY=

FRAGILELLM_TEMPERATURE=0.2
FRAGILELLM_TIMEOUT_SECONDS=120

FRAGILELLM_FLAG_A=FLAG{prompt_injection_system_leak}
FRAGILELLM_FLAG_B=FLAG{tool_sqli_user_2}
FRAGILELLM_FLAG_C=FLAG{rag_indirect_injection}
FRAGILELLM_FLAG_D=FLAG{path_traversal_lab_file}
FRAGILELLM_FLAG_E=FLAG{ssrf_internal_secret}
FRAGILELLM_FLAG_F=FLAG{debug_prompt_dump}
FRAGILELLM_FLAG_G=FLAG{cross_user_memory_bleed}
FRAGILELLM_FLAG_H=FLAG{tool_exfil_webhook}
FRAGILELLM_ADMIN_PASSWORD=WubbaLubbaDubDub42

# Tool call/result leak into chat (ON = intentional vuln)
FRAGILELLM_LEAK_TOOLS=1
FRAGILELLM_DEBUG_TRACE=0
